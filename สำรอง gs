function doGet(e) {
  const writes = ["resetroom", "resettodayall", "resetrange", "resetall", "updateroomorder", "addroom", "deleteroom", "editroom", "updateterm", "updatesigconfig", "autofill", "backuprecords"];
  if (writes.includes(String(e.parameter.mode || "").toLowerCase())) {
    try { return withBurapaWrite_(() => burapaGet_(e)); }
    catch (err) { return output({ status: "error", message: String(err.message || err) }); }
  }
  return burapaGet_(e);
}
function burapaGet_(e) {

  try {

    const page = e.parameter.page

    if (page === "report_page") {
      return HtmlService
        .createHtmlOutputFromFile("report")
        .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    }

    const mode = (e.parameter.mode || "").toLowerCase()

    let result = {}

    if (mode === "getdashboard") {
      result = getDashboard()
    }
    else if (mode === "getlatest") {
      result = getLatest(e)
    }
    else if (mode === "getbydate") {
      result = getByDate(e)
    }
    else if (mode === "formdata") {
      result = getFormData_(e)
    }
    else if (mode === "hasdata") {
      result = hasData(e)
    }
    else if (mode === "getlatestroom") {
      result = getLatestRoom(e)
    }
    else if (mode === "resetroom") {
      result = resetRoom(e)
    }
    else if (mode === "resettodayall") {
      result = resetTodayAll()
    }
    else if (mode === "resetrange") {
      result = resetRange(e)
    }
    else if (mode === "resetall") {
      result = resetAll()
    }
    else if (mode === "statuscheck") {
      result = statusCheck()
    }
    else if (mode === "updateroomorder") {
      result = updateRoomOrder(e)
    }
    else if (mode === "getterm") {
      result = getTerm()
    }
    else if (mode === "addroom") {
      result = addRoom(e.parameter.room)
    }
    else if (mode === "deleteroom") {
      result = deleteRoom(e.parameter.room)
    }
    else if (mode === "editroom") {
      result = renameRoom(e.parameter.old, e.parameter.new)
    }
    else if (mode === "updateterm") {
      result = updateTerm(e)
    }
    else if (mode === "report") {
      result = getReport(e)
    }
    else if (mode === "getsigconfig") {
      result = getSignatureConfig()
    }
    else if (mode === "updatesigconfig") {
      result = updateSignatureConfig(e)
    }
    else if (mode === "getprevious") {
      result = getPreviousData(e.parameter.room, e.parameter.date)
    }
    else if (mode === "autofill") {
      result = autoFillToday()
    }
    else if (mode === "backuprecords") {
      return backupRecords(e)
    }
    else {
      result = {
        status: "API Running",
        mode: mode || null
      }
    }

    return ContentService
      .createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON)

  } catch (err) {
    return ContentService
      .createTextOutput(JSON.stringify({
        status: "error",
        message: err.toString()
      }))
      .setMimeType(ContentService.MimeType.JSON)
  }

}

function doPost(e) {

  if (e.postData && e.postData.contents) {
    try {
      const json = JSON.parse(e.postData.contents);

      if (json.events) {
        Logger.log(JSON.stringify(json));
        return ContentService.createTextOutput("ok");
      }

    } catch (err) { }
  }

  const data = e.parameter

  if (data.mode === "updatesigconfig") {
    return ContentService
      .createTextOutput(JSON.stringify(withBurapaWrite_(() => updateSignatureConfig(e))))
      .setMimeType(ContentService.MimeType.JSON)
  }

  if (data.mode === "login") {
    return ContentService
      .createTextOutput(JSON.stringify(adminLogin(data)))
      .setMimeType(ContentService.MimeType.JSON)
  }

  const lock = LockService.getScriptLock()
  lock.waitLock(30000)

  try {

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID)
    const sheet = ss.getSheetByName("record_stu")

    const now = new Date()

    let dateShort

    if (data.record_date) {

      dateShort = data.record_date

    } else {

      dateShort = Utilities.formatDate(
        now,
        "Asia/Bangkok",
        "yyyy-MM-dd"
      )

    }

    const timestamp = Utilities.formatDate(
      now,
      "Asia/Bangkok",
      "dd-MM-yyyy HH:mm:ss"
    )

    const all_boys = Number(data.all_boys) || 0
    const all_girls = Number(data.all_girls) || 0
    const boys_today = Number(data.boys_today) || 0
    const girls_today = Number(data.girls_today) || 0

    const sick = Number(data.sick) || 0
    const leave = Number(data.leave) || 0
    const absent = Number(data.absent) || 0

    const all_total = all_boys + all_girls
    const total_today = boys_today + girls_today

    const lastRow = sheet.getLastRow()

    let rows = []
    let foundRow = null

    if (lastRow > 1) {

      rows = sheet.getRange(2, 1, lastRow - 1, 2).getValues()

    }

    if (!data.room) {
      return ContentService.createTextOutput(JSON.stringify({
        status: "error",
        message: "missing room"
      }))
    }

    for (let i = 0; i < rows.length; i++) {

      const rowDate = Utilities.formatDate(
        new Date(rows[i][0]),
        "Asia/Bangkok",
        "yyyy-MM-dd"
      )

      if (rowDate === dateShort && rows[i][1] === data.room) {
        foundRow = i + 2
        break
      }

    }

    const rowData = [

      dateShort,
      data.room,

      all_boys,
      all_girls,
      all_total,

      boys_today,
      girls_today,
      total_today,

      sick,
      leave,
      absent,

      timestamp,

      data.source || "บันทึกโดยคุณครู"

    ]

    if (foundRow) {

      sheet.getRange(foundRow, 1, 1, rowData.length)
        .setValues([rowData])

    } else {

      sheet.getRange(sheet.getLastRow() + 1, 1, 1, rowData.length).setValues([rowData])

    }

    updateCurrentStatusRoom(rowData, ss);

    SpreadsheetApp.flush();
    clearDashboardCache();

    return ContentService
      .createTextOutput(JSON.stringify({ status: "success" }))
      .setMimeType(ContentService.MimeType.JSON)

  }

  finally {

    try { SpreadsheetApp.flush() } finally { lock.releaseLock() }
  }

}

function getDashboard() {

  const cache = CacheService.getScriptCache();
  const dashboardKey = "dashboard_v3_" + (PropertiesService.getScriptProperties().getProperty("BURAPA_DASH_REV") || "0");
  const cached = cache.get(dashboardKey);

  if (cached) {
    return JSON.parse(cached);
  }

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID)

  const classSheet = ss.getSheetByName("classrooms")
  const recordSheet = ss.getSheetByName("record_stu")
  const statusSheet = ss.getSheetByName("current_status")

  let classrooms = []

  if (classSheet.getLastRow() > 1) {
    classrooms = classSheet
      .getRange(2, 1, classSheet.getLastRow() - 1, 1)
      .getValues()
      .flat()
  }

  let currentRecords = []

  if (statusSheet && statusSheet.getLastRow() > 1) {
    currentRecords = statusSheet
      .getRange(2, 1, statusSheet.getLastRow() - 1, 15)
      .getValues()
  }

  let records = []

  if (recordSheet.getLastRow() > 1) {
    records = recordSheet
      .getRange(2, 1, recordSheet.getLastRow() - 1, 13)
      .getValues()
  }

  const today = Utilities.formatDate(
    new Date(),
    "Asia/Bangkok",
    "yyyy-MM-dd"
  )

  let present = 0
  let sick = 0
  let leave = 0
  let absent = 0
  let total = 0

  const submitted = new Set()
  let latestRoomTotals = {}
  let latestRoomDates = {}
  let latestRoomTime = {}
  let latestRoomSource = {}

  let latestTeacherDates = {}
  let latestTeacherTime = {}

  currentRecords.forEach(r => {

    if (!r[0]) return

    const room = String(r[0]).trim()
    const rawDate = new Date(r[1])

    let timeStampObj = null

    if (r[11]) {

      if (Object.prototype.toString.call(r[11]) === "[object Date]") {

        timeStampObj = r[11]

      } else if (typeof r[11] === "string") {

        const parts = r[11].split(" ")

        if (parts.length === 2) {

          const [d, m, y] = parts[0].split("-")
          const [hh, mm, ss] = parts[1].split(":")

          timeStampObj = new Date(
            y,
            m - 1,
            d,
            hh,
            mm,
            ss
          )
        }
      }
    }

    if (!timeStampObj) {
      timeStampObj = rawDate
    }

    latestRoomDates[room] = timeStampObj
    latestRoomTotals[room] = Number(r[4]) || 0
    latestRoomTime[room] = r[11]
    latestRoomSource[room] = r[12]

    if (r[13]) {

      const teacherDate = new Date(r[13])

      if (!isNaN(teacherDate.getTime())) {
        latestTeacherDates[room] = teacherDate
      }

    }

    if (r[14]) {
      latestTeacherTime[room] = r[14]
    }

    const rowDate = Utilities.formatDate(
      rawDate,
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDate === today) {

      present += Number(r[5]) || 0
      present += Number(r[6]) || 0

      sick += Number(r[8]) || 0
      leave += Number(r[9]) || 0
      absent += Number(r[10]) || 0

      submitted.add(room)
    }
  })

  total = classrooms.reduce((sum, room) => {
    return sum + (latestRoomTotals[room] || 0)
  }, 0)

  const rooms = classrooms.map(room => {

    const hasData = latestRoomTotals[room] != null

    return {
      room: room,
      submitted: submitted.has(room),

      total: hasData ? latestRoomTotals[room] : 0,

      lastUpdateDate: latestRoomDates[room]
        ? Utilities.formatDate(
          latestRoomDates[room],
          "Asia/Bangkok",
          "yyyy-MM-dd"
        )
        : null,

      lastUpdateTime: latestRoomTime[room]
        ? formatTime(latestRoomTime[room])
        : "-",

      updatedBy: latestRoomSource[room] || "ยังไม่มีข้อมูล",

      lastTeacherUpdateDate: latestTeacherDates[room]
        ? Utilities.formatDate(
          latestTeacherDates[room],
          "Asia/Bangkok",
          "yyyy-MM-dd"
        )
        : null,

      lastTeacherUpdateTime: latestTeacherTime[room]
        ? formatTime(latestTeacherTime[room])
        : null,

      status: hasData ? "มีข้อมูล" : "ไม่มีข้อมูล"
    }

  })

  const unknown = Math.max(
    0,
    total - (present + sick + leave + absent)
  )

  let weeklyMap = {}

  records.forEach(r => {
    const date = Utilities.formatDate(new Date(r[0]), "Asia/Bangkok", "yyyy-MM-dd")

    if (!weeklyMap[date]) {
      weeklyMap[date] = { present: 0, absent: 0 }
    }

    weeklyMap[date].present += (Number(r[5]) || 0) + (Number(r[6]) || 0)
    weeklyMap[date].absent += Number(r[10]) || 0
  })

  const weeklyDates = Object.keys(weeklyMap).sort().slice(-7)

  const weekly = {
    labels: weeklyDates,
    present: weeklyDates.map(d => weeklyMap[d].present),
    absent: weeklyDates.map(d => weeklyMap[d].absent)
  }

  let monthlyMap = {}

  records.forEach(r => {
    const month = Utilities.formatDate(new Date(r[0]), "Asia/Bangkok", "yyyy-MM")

    if (!monthlyMap[month]) {
      monthlyMap[month] = { present: 0, absent: 0 }
    }

    monthlyMap[month].present += (Number(r[5]) || 0) + (Number(r[6]) || 0)
    monthlyMap[month].absent += Number(r[10]) || 0
  })

  const monthlyKeys = Object.keys(monthlyMap).sort().slice(-6)

  const monthly = {
    labels: monthlyKeys,
    present: monthlyKeys.map(m => monthlyMap[m].present),
    absent: monthlyKeys.map(m => monthlyMap[m].absent)
  }

  const result = {
    total,
    present,
    sick,
    leave,
    absent,
    unknown,
    rooms,
    weekly,
    monthly
  };

  try {
    const encoded = JSON.stringify(result);
    if (Utilities.newBlob(encoded).getBytes().length < 95000) cache.put(dashboardKey, encoded, 60);
  } catch (_) { }

  return result;

}

function formatTime(ts) {

  if (!ts) return "-"

  try {

    if (ts instanceof Date) {
      return Utilities.formatDate(
        ts,
        "Asia/Bangkok",
        "HH:mm"
      ) + " น."
    }

    if (typeof ts === "string") {

      const d = new Date(ts)

      if (!isNaN(d.getTime())) {
        return Utilities.formatDate(
          d,
          "Asia/Bangkok",
          "HH:mm"
        ) + " น."
      }

      const parts = ts.split(" ")

      if (parts.length >= 2) {
        return parts[1].substring(0, 5) + " น."
      }
    }

    return "-"

  } catch (err) {
    return "-"
  }

}

