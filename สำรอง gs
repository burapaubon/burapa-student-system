function resetRoom(e) {

  const room = e.parameter.room
  if (!room) {
    return { status: "error", message: "no room" }
  }

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID)
  const sheet = ss.getSheetByName("record_stu")

  const today = Utilities.formatDate(
    new Date(),
    "Asia/Bangkok",
    "yyyy-MM-dd"
  )

  const data = sheet.getDataRange().getValues()

  let deleted = 0

  for (let i = data.length - 1; i >= 1; i--) {

    const rowDate = Utilities.formatDate(
      new Date(data[i][0]),
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDate === today && data[i][1] === room) {
      sheet.deleteRow(i + 1)
      deleted++
    }

  }

  rebuildCurrentStatus()

  clearDashboardCache();

  return {
    status: "success",
    deleted: deleted
  }

}

