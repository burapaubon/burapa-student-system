function backupRecords(e) {

  try {

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID)

    const sourceSheet = ss.getSheetByName("record_stu")
    const configSheet = ss.getSheetByName("settings")

    if (!sourceSheet) {
      return output({
        status: "error",
        message: "record_stu not found"
      })
    }

    if (!configSheet) {
      return output({
        status: "error",
        message: "settings not found"
      })
    }

    let term = String(
      configSheet.getRange("B1").getValue() || ""
    ).trim()

    let year = String(
      configSheet.getRange("B2").getValue() || ""
    ).trim()

    if (!term) term = "term"
    if (!year) year = "year"

    let sheetName = `${term}-${year}`

    let count = 2

    while (ss.getSheetByName(sheetName)) {
      sheetName = `${term}-${year}(${count})`
      count++
    }

    const copied = sourceSheet.copyTo(ss)

    copied.setName(sheetName)

    ss.setActiveSheet(copied)
    ss.moveActiveSheet(ss.getSheets().length)

    return output({
      status: "success",
      sheetName: sheetName
    })

  } catch (err) {

    Logger.log(err)

    return output({
      status: "error",
      message: err.toString()
    })

  }

}

