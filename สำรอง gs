function resetRange(e) {

  const start = e.parameter.start
  const end = e.parameter.end

  if (!start || !end) {
    return { status: "error", message: "missing date" }
  }

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID)
  const sheet = ss.getSheetByName("record_stu")

  const data = sheet.getDataRange().getValues()

  let deleted = 0

  for (let i = data.length - 1; i >= 1; i--) {

    const rowDate = Utilities.formatDate(
      new Date(data[i][0]),
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDate >= start && rowDate <= end) {
      sheet.deleteRow(i + 1)
      deleted++
    }

  }

  const formatDate = d => {
    const date = new Date(d)
    return Utilities.formatDate(date, "Asia/Bangkok", "dd/MM/yyyy")
  }

  notifyAdminAction(
