function getPreviousData(room, dateStr, existingRows) {

  let data = existingRows

  if (!data) {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID)
    const sheet = ss.getSheetByName("record_stu")
    data = sheet.getDataRange().getValues()
  }

  let latest = null
  let latestTime = 0

  for (let i = 1; i < data.length; i++) {

    const row = data[i]

    if (row[1] !== room) continue

    const rowDateStr = Utilities.formatDate(
      new Date(row[0]),
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDateStr >= dateStr) continue

    let time = 0

    if (row[11]) {
      if (Object.prototype.toString.call(row[11]) === "[object Date]") {
        time = row[11].getTime()
      } else if (typeof row[11] === "string") {
        const parts = row[11].split(" ")
        if (parts.length === 2) {
          const [d, m, y] = parts[0].split("-")
          const [hh, mm, ss] = parts[1].split(":")
          time = new Date(y, m - 1, d, hh, mm, ss).getTime()
        }
      }
    }

    if (!time) {
      time = new Date(row[0]).getTime()
    }

    if (time > latestTime) {
      latestTime = time
      latest = row
    }

  }

  if (!latest) return {}

  return {
    all_boys: latest[2],
    all_girls: latest[3]
  }
}

function notifyStudentChange(room, prev, curr) {

  const diffMale = curr.male - prev.male
  const diffFemale = curr.female - prev.female

  if (diffMale === 0 && diffFemale === 0) {
    return
  }

  if (prev.male === 0 && prev.female === 0) {
    return
  }

  let msg = "📊 แจ้งเตือนการเปลี่ยนแปลงจำนวนนักเรียน\n\n"
  msg += "🏫 ห้อง: " + room + "\n\n"

  let hasAdd = (diffMale > 0 || diffFemale > 0)
  let hasRemove = (diffMale < 0 || diffFemale < 0)
  let hasChange = false

  if (hasAdd) {
    msg += "➕ เข้าใหม่:\n"
    msg += "- ชาย: " + Math.max(diffMale, 0) + "\n"
    msg += "- หญิง: " + Math.max(diffFemale, 0) + "\n"
    msg += "- รวม: " + (Math.max(diffMale, 0) + Math.max(diffFemale, 0))
    hasChange = true
  }

  if (hasRemove) {
    if (hasAdd) {
      msg += "\n\n"
    }

    msg += "➖ จำหน่ายออก:\n"
    msg += "- ชาย: " + Math.abs(Math.min(diffMale, 0)) + "\n"
    msg += "- หญิง: " + Math.abs(Math.min(diffFemale, 0)) + "\n"
    msg += "- รวม: " + (Math.abs(Math.min(diffMale, 0)) + Math.abs(Math.min(diffFemale, 0)))
    hasChange = true
  }

  if (hasChange) {
    const total = curr.male + curr.female

    msg += "\n\n👥 จำนวนนักเรียนปัจจุบัน:\n"
    msg += "- ชาย: " + curr.male + "\n"
    msg += "- หญิง: " + curr.female + "\n"
    msg += "- รวม: " + total
  }

  sendLineToStudentGroup(msg)
}

