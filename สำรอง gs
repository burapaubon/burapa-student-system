function rebuildCurrentStatus() {

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const recordSheet = ss.getSheetByName("record_stu");

  let statusSheet = ss.getSheetByName("current_status");

  if (!statusSheet) {
    statusSheet = ss.insertSheet("current_status");
  }

  statusSheet.clearContents();

  const headers = [
    "room",
    "record_date",
    "all_boys",
    "all_girls",
    "all_total",
    "boys_today",
    "girls_today",
    "total_today",
    "sick",
    "leave",
    "absent",
    "timestamp",
    "source",
    "last_teacher_date",
    "last_teacher_timestamp"
  ];

  statusSheet
    .getRange(1, 1, 1, headers.length)
    .setValues([headers]);

  const lastRow = recordSheet.getLastRow();

  if (lastRow <= 1) {
    return {
      status: "success",
      rooms: 0,
      message: "ไม่พบข้อมูลใน record_stu"
    };
  }

  const records = recordSheet
    .getRange(2, 1, lastRow - 1, 13)
    .getValues();

  const latestByRoom = {};

  const latestTeacherByRoom = {};

  records.forEach(row => {

    if (!row[0] || !row[1]) return;

    const room = String(row[1]).trim();

    const recordDate = new Date(row[0]);

    let timestampValue = 0;

    if (row[11] instanceof Date) {

      timestampValue = row[11].getTime();

    } else if (row[11]) {

      const text = String(row[11]).trim();
      const parts = text.split(" ");

      if (parts.length === 2) {

        const dateParts = parts[0].split("-");
        const timeParts = parts[1].split(":");

        if (dateParts.length === 3 && timeParts.length >= 2) {

          const d = Number(dateParts[0]);
          const m = Number(dateParts[1]);
          const y = Number(dateParts[2]);

          const hh = Number(timeParts[0]) || 0;
          const mm = Number(timeParts[1]) || 0;
          const ss = Number(timeParts[2]) || 0;

          const parsed = new Date(
            y,
            m - 1,
            d,
            hh,
            mm,
            ss
          );

          if (!isNaN(parsed.getTime())) {
            timestampValue = parsed.getTime();
          }
        }
      }
    }

    if (!timestampValue && !isNaN(recordDate.getTime())) {
      timestampValue = recordDate.getTime();
    }

    if (
      !latestByRoom[room] ||
      timestampValue > latestByRoom[room].time
    ) {

      latestByRoom[room] = {
        time: timestampValue,
        row: row
      };

    }

    const source = String(row[12] || "").trim().toLowerCase();
    const isAuto = source.includes("autofill");

    if (!isAuto) {

      if (
        !latestTeacherByRoom[room] ||
        timestampValue > latestTeacherByRoom[room].time
      ) {

        latestTeacherByRoom[room] = {
          time: timestampValue,
          row: row
        };

      }
    }

  });

  const classSheet = ss.getSheetByName("classrooms");

  let classroomOrder = [];

  if (classSheet && classSheet.getLastRow() > 1) {
    classroomOrder = classSheet
      .getRange(2, 1, classSheet.getLastRow() - 1, 1)
      .getValues()
      .flat()
      .map(room => String(room).trim())
      .filter(room => room);
  }

  const outputRows = classroomOrder
    .filter(room => latestByRoom[room])
    .map(room => {

      const r = latestByRoom[room].row;

      const teacher = latestTeacherByRoom[room]
        ? latestTeacherByRoom[room].row
        : null;

      return [
        room,
        r[0],
        r[2],
        r[3],
        r[4],
        r[5],
        r[6],
        r[7],
        r[8],
        r[9],
        r[10],
        r[11],
        r[12],
        teacher ? teacher[0] : "",
        teacher ? teacher[11] : ""
      ];

    });

  if (outputRows.length > 0) {

    statusSheet
      .getRange(2, 1, outputRows.length, 15)
      .setValues(outputRows);

  }

  statusSheet.setFrozenRows(1);
  statusSheet.autoResizeColumns(1, 15);

  SpreadsheetApp.flush();

  return {
    status: "success",
    rooms: outputRows.length,
    recordsScanned: records.length,
    message: "สร้าง current_status เรียบร้อยแล้ว"
  };
}

function updateCurrentStatusRoom(rowData, existingBook) {

  const ss = existingBook || SpreadsheetApp.openById(SPREADSHEET_ID);
  const statusSheet = ss.getSheetByName("current_status");

  if (!statusSheet || !rowData || !rowData[1]) return;

  const room = String(rowData[1]).trim();

  const lastRow = statusSheet.getLastRow();
  let targetRow = null;

  if (lastRow > 1) {

    const rooms = statusSheet
      .getRange(2, 1, lastRow - 1, 1)
      .getValues()
      .flat();

    const index = rooms.findIndex(r =>
      String(r).trim() === room
    );

    if (index !== -1) {
      targetRow = index + 2;
    }
  }

  let lastTeacherDate = "";
  let lastTeacherTimestamp = "";

  if (targetRow) {

    const teacherData = statusSheet
      .getRange(targetRow, 14, 1, 2)
      .getValues()[0];

    lastTeacherDate = teacherData[0] || "";
    lastTeacherTimestamp = teacherData[1] || "";
  }

  const source = String(rowData[12] || "")
    .trim()
    .toLowerCase();

  const isAuto = source.includes("autofill");

  if (!isAuto) {
    lastTeacherDate = rowData[0] || "";
    lastTeacherTimestamp = rowData[11] || "";
  }

  const statusRow = [
    room,
    rowData[0],
    rowData[2],
    rowData[3],
    rowData[4],
    rowData[5],
    rowData[6],
    rowData[7],
    rowData[8],
    rowData[9],
    rowData[10],
    rowData[11],
    rowData[12],
    lastTeacherDate,
    lastTeacherTimestamp
  ];

  if (targetRow) {

    statusSheet
      .getRange(targetRow, 1, 1, 15)
      .setValues([statusRow]);

  } else {

    statusSheet.appendRow(statusRow);

  }
}

function clearDashboardCache() {
  PropertiesService.getScriptProperties().setProperty("BURAPA_DASH_REV", Utilities.getUuid());
  CacheService
    .getScriptCache()
    .remove("dashboard_v2");
}

function getFormData_(e) {
  const room = e.parameter.room, date = e.parameter.date;
  if (!room || !date) return { data: {}, hasData: false };
  const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("record_stu");
  const n = sheet.getLastRow() - 1;
  if (n <= 0) return { data: {}, hasData: false };
  const rows = sheet.getRange(2, 1, n, 13).getValues();
  let hasData = false, data = {};
  for (let i = rows.length - 1; i >= 0; i--) {
    const r = rows[i];
    if (Utilities.formatDate(new Date(r[0]), "Asia/Bangkok", "yyyy-MM-dd") !== date) continue;
    hasData = true;
    if (r[1] === room) {
      data = { all_boys: r[2], all_girls: r[3], boys_today: r[5], girls_today: r[6], sick: r[8], leave: r[9], absent: r[10], source: r[12] };
      break;
    }
  }
  return { data, hasData };
}

function previousRooms_(records, date) {
  const result = new Map(), times = new Map();
  for (let i = 1; i < records.length; i++) {
    const row = records[i];
    if (Utilities.formatDate(new Date(row[0]), "Asia/Bangkok", "yyyy-MM-dd") >= date) continue;
    let time = 0;
    if (Object.prototype.toString.call(row[11]) === "[object Date]") time = row[11].getTime();
    else if (typeof row[11] === "string") {
      const parts = row[11].split(" ");
      if (parts.length === 2) { const [d, m, y] = parts[0].split("-"); const [hh, mm, ss] = parts[1].split(":"); time = new Date(y, m - 1, d, hh, mm, ss).getTime(); }
    }
    if (!time) time = new Date(row[0]).getTime();
    if (time > (times.get(row[1]) || 0)) { times.set(row[1], time); result.set(row[1], { all_boys: row[2], all_girls: row[3] }); }
  }
  return result;
}

let BURAPA_WRITE_ACTIVE_ = false;
function withBurapaWrite_(work) {
  if (BURAPA_WRITE_ACTIVE_) return work();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) throw Error("ระบบกำลังบันทึกข้อมูล กรุณาลองใหม่อีกครั้ง");
  BURAPA_WRITE_ACTIVE_ = true;
  try { return work(); }
  finally {
    try { SpreadsheetApp.flush(); clearDashboardCache(); }
    finally { BURAPA_WRITE_ACTIVE_ = false; lock.releaseLock(); }
  }
}