function getReport(e) {

  const date = e.parameter.date
  if (!date) return []

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID)
  const recordSheet = ss.getSheetByName("record_stu")
  const classSheet = ss.getSheetByName("classrooms")

  const records = recordSheet.getDataRange().getValues()
  const classes = classSheet.getLastRow() > 1 ? classSheet.getRange(2, 1, classSheet.getLastRow() - 1, 1).getValues().flat() : []
  const previous = previousRooms_(records, date)

  let map = {}

  classes.forEach(c => {
    map[c] = {
      room: c,
      male: 0, female: 0, total: 0,
      prev_male: Number((previous.get(c) || {}).all_boys) || 0,
      prev_female: Number((previous.get(c) || {}).all_girls) || 0,
      present_m: 0, present_f: 0, present: 0,
      sick: 0, leave: 0, absent: 0,
      _time: 0
    }
  })

  records.slice(1).forEach(r => {

    const rowDate = Utilities.formatDate(new Date(r[0]), "Asia/Bangkok", "yyyy-MM-dd")
    if (rowDate !== date) return

    const room = r[1]

    if (!map[room]) return

    const prevData = previous.get(room) || {}

    map[room].prev_male = Number(prevData.all_boys) || 0
    map[room].prev_female = Number(prevData.all_girls) || 0

    if (!map[room]) return

    let time = 0
    if (r[11]) {
      if (Object.prototype.toString.call(r[11]) === "[object Date]") {
        time = r[11].getTime()
      } else {
        const parts = r[11].split(" ")
        if (parts.length === 2) {
          const [d, m, y] = parts[0].split("-")
          const [hh, mm, ss] = parts[1].split(":")
          time = new Date(y, m - 1, d, hh, mm, ss).getTime()
        }
      }
    }

    if (time < map[room]._time) return
    map[room]._time = time

    map[room].male = Number(r[2]) || 0
    map[room].female = Number(r[3]) || 0
    map[room].total = Number(r[4]) || 0

    map[room].present_m = Number(r[5]) || 0
    map[room].present_f = Number(r[6]) || 0
    map[room].present = Number(r[7]) || 0

    map[room].sick = Number(r[8]) || 0
    map[room].leave = Number(r[9]) || 0
    map[room].absent = Number(r[10]) || 0

  })

  return Object.values(map)
}

