function burapaAutoFill_() {

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID)

  const classSheet = ss.getSheetByName("classrooms")
  const recordSheet = ss.getSheetByName("record_stu")

  const today = Utilities.formatDate(
    new Date(),
    "Asia/Bangkok",
    "yyyy-MM-dd"
  )

  const timestamp = Utilities.formatDate(
    new Date(),
    "Asia/Bangkok",
    "dd-MM-yyyy HH:mm:ss"
  )

  let classrooms = classSheet
    .getRange(2, 1, classSheet.getLastRow() - 1, 1)
    .getValues()
    .flat()

  let records = []

  if (recordSheet.getLastRow() > 1) {
    records = recordSheet
      .getRange(2, 1, recordSheet.getLastRow() - 1, 13)
      .getValues()
  }

  let recordedRooms = new Set()

  let autofilledRooms = []

  let hasManualRecordToday = false
  let hasAnyRecordToday = false

  records.forEach(r => {

    const rowDate = Utilities.formatDate(
      new Date(r[0]),
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDate === today) {

      hasAnyRecordToday = true

      if (r[12] !== "บันทึกโดยระบบ Autofill") {
        recordedRooms.add(r[1])
        hasManualRecordToday = true
      }

    }

  })

  if (!hasManualRecordToday) {
    Logger.log("ไม่พบข้อมูลที่สามารถ Autofill")
    return
  }

  for (let i = records.length - 1; i >= 0; i--) {

    const rowDate = Utilities.formatDate(
      new Date(records[i][0]),
      "Asia/Bangkok",
      "yyyy-MM-dd"
    )

    if (rowDate === today && records[i][12] === "บันทึกโดยระบบ Autofill") {
      recordSheet.deleteRow(i + 2)
    }

  }

  classrooms.forEach(room => {

    if (!recordedRooms.has(room)) {

      let lastMale = 0
      let lastFemale = 0
      let totalStudents = 0

      for (let i = records.length - 1; i >= 0; i--) {

        if (

          records[i][1] === room &&
          records[i][12] !== "บันทึกโดยระบบ Autofill"

        ) {

          let m = Number(records[i][2]) || 0
          let f = Number(records[i][3]) || 0
          let t = Number(records[i][4]) || 0

          if (t > 0 && (m + f === 0)) {
            continue

          }

          lastMale = m
          lastFemale = f
          totalStudents = t

          break

        }

      }

      const rowData = [

        today,
        room,

        lastMale,
        lastFemale,
        totalStudents,

        lastMale,
        lastFemale,
        totalStudents,

        0,
        0,
        0,

        timestamp,

        "บันทึกโดยระบบ Autofill"

      ]

      if (totalStudents > 0) {

        recordSheet.appendRow(rowData)

        updateCurrentStatusRoom(rowData, ss)



        autofilledRooms.push(room)
      }

    }

  })

}

